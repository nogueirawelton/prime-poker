# WordPress headless (GraphQL + Contact Form 7)
NEXT_PUBLIC_ADMIN_URL=https://admin.primepokerteam.com.br

# Metadados / SEO
NEXT_PUBLIC_SITE_URL=https://primepokerteam.com.br
NEXT_PUBLIC_SITE_NAME=Prime Poker Team

# Feed do Instagram
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_INSTAGRAM_PROFILE=

# Autenticação (wp-graphql-jwt-authentication)
# Mesmo valor de GRAPHQL_JWT_AUTH_SECRET_KEY no wp-config.php do WordPress.
# É um segredo SIMÉTRICO: assina tokens válidos, nunca pode ir para o cliente.
WP_JWT_SECRET=

# Planilha de inscrições (Apps Script publicado como Web App)
# URL do /exec gerada pelo script. É server-only de propósito: publicada, viraria
# um endpoint de escrita aberto na planilha. Só `/api/gsheets` a usa.
GOOGLE_SHEETS_SCRIPT_URL=
